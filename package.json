{
  "name": "web-platform",
  "private": true,
  "author": {
    "name": "Ahad Chowdhury",
    "url": "https://www.ahadchowdhury.com"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:portfolio": "bun --bun run --filter public-static dev",
    "dev:blog": "bun run --filter technical-date dev",
    "build": "bun run build:design-system && bun run --filter public-static --filter technical-date build",
    "build:design-system": "bun run --filter @web-platform/design-system build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
